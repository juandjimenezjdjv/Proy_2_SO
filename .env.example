# Configuración de ejemplo para Mini-Spark
# Copia este archivo a .env en la raíz del proyecto para personalizarlo

# Configuración del Master
MASTER_HOST=0.0.0.0
MASTER_PORT=8080

# Configuración de Heartbeats
HEARTBEAT_SEC=2
HEARTBEAT_TIMEOUT_SEC=10

# Configuración de Workers
WORKER_THREADS=4
MAX_RETRIES=3

# Configuración de Almacenamiento
DATA_DIR=/app/data
RESULTS_DIR=/app/results

# Configuración de Logging
# Niveles: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
