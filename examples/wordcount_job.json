{
  "id": "wordcount-example",
  "name": "WordCount Example",
  "dag": {
    "nodes": [
      {
        "id": "read",
        "operator": "read_csv",
        "input_paths": ["input.csv"],
        "output_path": "temp/wordcount_read.csv",
        "partitions": 4
      },
      {
        "id": "tokenize",
        "operator": "flat_map",
        "input_paths": ["temp/wordcount_read.csv"],
        "output_path": "temp/wordcount_tokens.csv",
        "partitions": 4,
        "params": {
          "fn": "split_words"
        }
      },
      {
        "id": "lowercase",
        "operator": "map",
        "input_paths": ["temp/wordcount_tokens.csv"],
        "output_path": "temp/wordcount_lower.csv",
        "partitions": 4,
        "params": {
          "fn": "lambda x: x.lower()"
        }
      },
      {
        "id": "count",
        "operator": "reduce_by_key",
        "input_paths": ["temp/wordcount_lower.csv"],
        "output_path": "results/wordcount_example_result.csv",
        "partitions": 2,
        "params": {
          "key": "word",
          "fn": "count"
        }
      }
    ],
    "edges": [
      {"from": "read", "to": "tokenize"},
      {"from": "tokenize", "to": "lowercase"},
      {"from": "lowercase", "to": "count"}
    ]
  },
  "parallelism": 4
}
