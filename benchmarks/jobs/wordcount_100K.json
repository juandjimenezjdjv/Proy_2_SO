{
  "job_id": "benchmark-wordcount-100K",
  "stages": [
    {
      "stage_id": "read",
      "operator": "read_csv",
      "config": {
        "input_path": "wordcount_100K.csv",
        "partitions": 8
      },
      "dependencies": []
    },
    {
      "stage_id": "tokenize",
      "operator": "flat_map",
      "config": {
        "function": "split_words",
        "input_column": "text"
      },
      "dependencies": ["read"]
    },
    {
      "stage_id": "lowercase",
      "operator": "map",
      "config": {
        "function": "lowercase",
        "input_column": "word",
        "output_column": "word"
      },
      "dependencies": ["tokenize"]
    },
    {
      "stage_id": "count",
      "operator": "reduce_by_key",
      "config": {
        "key_column": "word",
        "operation": "sum",
        "output_path": "results/wordcount_100K_result.csv"
      },
      "dependencies": ["lowercase"]
    }
  ]
}
